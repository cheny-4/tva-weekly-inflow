{
  "command_prefix": [
    "python",
    "pipeline.py"
  ],
  "repository_root_required": true,
  "version": "2.0.0",
  "capabilities": [
    {
      "name": "inspect",
      "argv": [
        "inspect",
        "--model",
        "{total_runoff_or_surface_runoff_static8}"
      ],
      "side_effect": "read_only",
      "requires_training_request": false,
      "requires_slurm_gpu": false,
      "output_files": []
    },
    {
      "name": "preprocess",
      "argv": [
        "preprocess",
        "--model",
        "{model_id}",
        "--config",
        "{map_configuration_json}",
        "--out",
        "{new_output_directory}"
      ],
      "side_effect": "write_new_basin_forcings_and_grid_weights",
      "requires_training_request": false,
      "requires_slurm_gpu": false,
      "output_files": [
        "weekly_inputs.csv",
        "forcing_metadata.json",
        "weekly_quality_by_region.csv",
        "preprocessing_audit.json",
        "weights/*.npz",
        "weights/*.json"
      ]
    },
    {
      "name": "infer",
      "argv": [
        "infer",
        "--model",
        "{total_runoff_or_surface_runoff_static8}",
        "--inputs",
        "{inputs_csv}",
        "--metadata",
        "{metadata_json}",
        "--out",
        "{new_output_directory}"
      ],
      "side_effect": "write_new_results",
      "requires_training_request": false,
      "requires_slurm_gpu": false,
      "output_files": [
        "predictions.csv",
        "provenance.json"
      ]
    },
    {
      "name": "replay",
      "argv": [
        "replay",
        "--model",
        "{total_runoff_or_surface_runoff_static8}",
        "--split",
        "{validation_or_test}",
        "--out",
        "{new_output_directory}"
      ],
      "side_effect": "write_new_results",
      "requires_training_request": false,
      "requires_slurm_gpu": false,
      "output_files": [
        "predictions.csv",
        "metrics_by_site.csv",
        "summary.json"
      ]
    },
    {
      "name": "plot",
      "argv": [
        "plot",
        "--model",
        "{total_runoff_or_surface_runoff_static8}",
        "--predictions",
        "{paired_predictions_csv}",
        "--out",
        "{new_output_directory}"
      ],
      "side_effect": "write_new_figures",
      "requires_training_request": false,
      "requires_slurm_gpu": false,
      "output_files": [
        "weekly_nse_by_site.png",
        "ELFxx_weekly.png",
        "metrics_by_site.csv"
      ]
    },
    {
      "name": "train",
      "argv": [
        "train",
        "--model",
        "{total_runoff_or_surface_runoff_static8}",
        "--out",
        "{new_output_directory}"
      ],
      "side_effect": "gpu_training_50_epochs",
      "requires_training_request": true,
      "requires_slurm_gpu": true,
      "output_files": [
        "best_model.pt",
        "last_model.pt",
        "run_config.json",
        "training_history.csv",
        "completion.json"
      ]
    }
  ],
  "artifact_roots": {
    "total_runoff": "baseline",
    "surface_runoff_static8": "baseline_surface_runoff_static8"
  },
  "legacy_default_model": "total_runoff",
  "model_registry": "models.json",
  "bias_correction": false
}
