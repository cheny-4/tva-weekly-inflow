{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TVA weekly basin forcing interchange",
  "type": "object",
  "required": [
    "metadata",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "calendar",
        "precipitation_units",
        "temperature_units",
        "runoff_units",
        "runoff_definition",
        "source_kind"
      ],
      "properties": {
        "calendar": {
          "const": "Monday-Sunday"
        },
        "precipitation_units": {
          "const": "mm/week"
        },
        "temperature_units": {
          "const": "degC"
        },
        "runoff_units": {
          "const": "mm/week"
        },
        "runoff_definition": {
          "enum": [
            "surface_runoff_plus_baseflow",
            "surface_runoff_only"
          ]
        },
        "source_kind": {
          "enum": [
            "historical",
            "forecast"
          ]
        },
        "model_id": {
          "enum": [
            "total_runoff",
            "surface_runoff_static8"
          ]
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "required": [
          "basin_id",
          "start",
          "precipitation_mm_week",
          "temperature_mean_c"
        ],
        "properties": {
          "basin_id": {
            "type": "string",
            "pattern": "^ELF(0[1-9]|[1-4][0-9]|5[0-2])$"
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "precipitation_mm_week": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "temperature_mean_c": {
            "type": [
              "number",
              "null"
            ]
          },
          "total_runoff_mm_week": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "surface_runoff_mm_week": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  },
  "description": "CSV+metadata JSON equivalent for two named checkpoints. Absent model_id is legacy total_runoff; surface requires explicit model_id. Runtime also checks chronology, existing head IDs, physical units and finite contiguous 13-week windows.",
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "required": [
              "model_id"
            ],
            "properties": {
              "model_id": {
                "const": "surface_runoff_static8"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runoff_definition": {
                "const": "surface_runoff_only"
              }
            }
          },
          "rows": {
            "items": {
              "required": [
                "surface_runoff_mm_week"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "metadata": {
            "properties": {
              "runoff_definition": {
                "const": "surface_runoff_plus_baseflow"
              }
            }
          },
          "rows": {
            "items": {
              "required": [
                "total_runoff_mm_week"
              ]
            }
          }
        }
      }
    }
  ]
}
